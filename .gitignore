# Lazarus compiler-generated binaries and objects (Linux-specific)
*.o
*.or
*.a
*.ppu
*.compiled
*.dbg

# General executable output (if you don't use extensions on Linux)
# Note: If your compiled binary has no extension, explicitly add its name here

# Lazarus autogenerated and resource files
*.lrs
*.res
*.rst
*.rsj
*.lrt

# Lazarus user-specific session files (Do NOT share these)
*.lps

# Lazarus backups and unit output folders
backup/
*.bak
lib/
